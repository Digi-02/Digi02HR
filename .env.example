# Django settings
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=django-insecure-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Africa/Lagos
# Static files
DJANGO_STATIC_URL=/static/
# DJANGO_STATIC_ROOT=C:\path\to\staticfiles

# Database (default is SQLite db.sqlite3)
DJANGO_DB_ENGINE=django.db.backends.sqlite3
# DJANGO_DB_NAME=db.sqlite3
# For Postgres/MySQL/etc:
# DJANGO_DB_ENGINE=django.db.backends.postgresql
# DJANGO_DB_NAME=microhr
# DJANGO_DB_USER=postgres
# DJANGO_DB_PASSWORD=secret
# DJANGO_DB_HOST=localhost
# DJANGO_DB_PORT=5432

# Security / proxy (useful in production)
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://www.your-domain.com
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SESSION_COOKIE_SECURE=True
# DJANGO_CSRF_COOKIE_SECURE=True
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# DJANGO_SECURE_HSTS_PRELOAD=True
# If behind a proxy that sets X-Forwarded-Proto:
# DJANGO_SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https
# DJANGO_USE_X_FORWARDED_HOST=True

# Email / SMTP
# Local development with Mailpit (run Mailpit on localhost:1025):
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_EMAIL_HOST=localhost
# DJANGO_EMAIL_PORT=1025
# DJANGO_EMAIL_USE_TLS=False
# DJANGO_EMAIL_USE_SSL=False
# DJANGO_EMAIL_HOST_USER=
# DJANGO_EMAIL_HOST_PASSWORD=
# Development default prints emails to the server console:
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=Digi02 HR <noreply@digi02hr.local>
# Production SMTP (transactional provider, e.g. SendGrid, Mailgun, Amazon SES):
# Set these to your provider's SMTP credentials:
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_EMAIL_HOST=smtp.example.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_HOST_USER=your@email.com
# DJANGO_EMAIL_HOST_PASSWORD=your-app-password
# DJANGO_EMAIL_USE_TLS=True
# DJANGO_EMAIL_USE_SSL=False
# DJANGO_EMAIL_TIMEOUT=10
# How long password-reset / owner-invite links are valid (seconds). Default 72h.
# DJANGO_PASSWORD_RESET_TIMEOUT=259200
# When True, the company setup wizard cannot finish until mailbox setup passes.
# DJANGO_REQUIRE_MAILBOX_SETUP=False
# The app also accepts Django's standard names without the DJANGO_ prefix:
# EMAIL_BACKEND, EMAIL_HOST, EMAIL_PORT, EMAIL_HOST_USER, EMAIL_HOST_PASSWORD,
# EMAIL_USE_TLS, EMAIL_USE_SSL, EMAIL_TIMEOUT, DEFAULT_FROM_EMAIL

# Individual work-mailbox passwords are encrypted with this external keyring.
# See WORK_MAILBOX.md for key generation, deployment, and rotation instructions.
# MAILBOX_ENCRYPTION_KEYS={"key-id":"urlsafe-fernet-key"}
# MAILBOX_ENCRYPTION_CURRENT_KEY_ID=key-id

# Read-only Digi02 Technical Command integration
# Generate a long random value and use the same value in Technical Command.
TECHNICAL_COMMAND_API_KEY=replace-with-a-long-random-secret
TECHNICAL_COMMAND_ORGANIZATION_SLUG=digi02
TECHNICAL_COMMAND_API_DEFAULT_PAGE_SIZE=25
TECHNICAL_COMMAND_API_MAX_PAGE_SIZE=100
